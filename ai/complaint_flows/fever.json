{
  "schema_version": 1,
  "flow_id": "fever",
  "version": "1.1.0",
  "namespace": "standard",
  "label": {"en": "Fever", "bn": "জ্বর", "hi": "बुखार"},
  "applicable_complaint": "fever",
  "content_status": "prototype_unvalidated",
  "traversal": "ordered_applicable",
  "completion": "all_applicable_addressed",
  "sections": [
    {
      "section_id": "chief_complaint",
      "label": {"en": "Chief complaint", "bn": "প্রধান সমস্যা", "hi": "मुख्य समस्या"},
      "questions": [
        {
          "question_id": "chief_complaint.description",
          "field": "chief_complaint.description",
          "type": "short_text",
          "required": true,
          "allow_unknown": true,
          "text": {"en": "Describe your main concern in your own words.", "bn": "আপনার প্রধান সমস্যা নিজের ভাষায় বলুন।", "hi": "अपनी मुख्य समस्या अपने शब्दों में बताएं।"}
        }
      ]
    },
    {
      "section_id": "hpi",
      "label": {"en": "Current fever", "bn": "বর্তমান জ্বর", "hi": "वर्तमान बुखार"},
      "questions": [
        {
          "question_id": "hpi.onset",
          "field": "hpi.onset",
          "type": "duration",
          "required": true,
          "allow_unknown": true,
          "text": {"en": "Since when have you had the fever?", "bn": "কতদিন ধরে আপনার জ্বর আছে?", "hi": "आपको बुखार कब से है?"},
          "constraints": {"minimum": 0, "maximum": 1000}
        },
        {
          "question_id": "hpi.temperature",
          "field": "hpi.temperature",
          "type": "number",
          "required": true,
          "allow_unknown": true,
          "text": {"en": "What is the highest measured temperature in °C?", "bn": "মাপা সর্বোচ্চ তাপমাত্রা কত °C?", "hi": "मापा गया सबसे अधिक तापमान °C में कितना है?"},
          "constraints": {"minimum": 0, "maximum": 60, "unit": "°C"}
        },
        {
          "question_id": "hpi.timing",
          "field": "hpi.timing",
          "type": "single_choice",
          "required": true,
          "allow_unknown": true,
          "text": {"en": "How has the fever behaved?", "bn": "জ্বরটি কীভাবে হচ্ছে?", "hi": "बुखार किस तरह हो रहा है?"},
          "options": [
            {"value": "constant", "label": {"en": "Continuous", "bn": "একটানা", "hi": "लगातार"}, "exclusive": false},
            {"value": "intermittent", "label": {"en": "Comes and goes", "bn": "আসে ও যায়", "hi": "आता-जाता है"}, "exclusive": false},
            {"value": "not_sure", "label": {"en": "Not sure", "bn": "নিশ্চিত নই", "hi": "पक्का नहीं"}, "exclusive": false}
          ]
        },
        {
          "question_id": "hpi.associated",
          "field": "hpi.associated",
          "type": "multiple_choice",
          "required": true,
          "allow_unknown": true,
          "text": {"en": "Which symptoms are you experiencing along with the fever?", "bn": "জ্বরের সঙ্গে কোন উপসর্গগুলি হচ্ছে?", "hi": "बुखार के साथ आपको कौन से लक्षण हो रहे हैं?"},
          "options": [
            {"value": "chills", "label": {"en": "Chills / shivering", "bn": "কাঁপুনি", "hi": "ठंड या कंपकंपी"}, "exclusive": false},
            {"value": "cough", "label": {"en": "Cough / sore throat", "bn": "কাশি / গলা ব্যথা", "hi": "खांसी / गले में दर्द"}, "exclusive": false},
            {"value": "gastrointestinal", "label": {"en": "Vomiting / diarrhea", "bn": "বমি / ডায়রিয়া", "hi": "उल्टी / दस्त"}, "exclusive": false},
            {"value": "abdominal_discomfort", "label": {"en": "Abdominal discomfort", "bn": "পেটে অস্বস্তি", "hi": "पेट में तकलीफ"}, "exclusive": false},
            {"value": "urinary", "label": {"en": "Burning or difficulty while urinating", "bn": "প্রস্রাবে জ্বালা বা অসুবিধা", "hi": "पेशाब में जलन या कठिनाई"}, "exclusive": false},
            {"value": "rash", "label": {"en": "Rash", "bn": "ফুসকুড়ি", "hi": "चकत्ते"}, "exclusive": false},
            {"value": "body_ache", "label": {"en": "Body ache", "bn": "শরীর ব্যথা", "hi": "शरीर में दर्द"}, "exclusive": false},
            {"value": "headache", "label": {"en": "Headache", "bn": "মাথাব্যথা", "hi": "सिरदर्द"}, "exclusive": false},
            {"value": "none", "label": {"en": "None of these", "bn": "এগুলির কোনোটিই নয়", "hi": "इनमें से कोई नहीं"}, "exclusive": true}
          ]
        },
        {
          "question_id": "hpi.associated_details",
          "field": "hpi.associated_details",
          "type": "short_text",
          "required": true,
          "allow_unknown": true,
          "text": {"en": "Please describe the cough or sore throat, including any phlegm or breathing change.", "bn": "কাশি বা গলা ব্যথা, কফ বা শ্বাসের পরিবর্তন থাকলে বলুন।", "hi": "खांसी या गले के दर्द, बलगम या सांस में बदलाव के बारे में बताएं।"},
          "depends_on": ["hpi.associated"],
          "when": [{"question_id": "hpi.associated", "operator": "contains", "value": "cough"}]
        },
        {
          "question_id": "hpi.gastrointestinal_details",
          "field": "hpi.gastrointestinal_details",
          "type": "short_text",
          "required": true,
          "allow_unknown": true,
          "text": {"en": "Please describe the vomiting or diarrhea, including how often it is happening.", "bn": "বমি বা ডায়রিয়া কতবার হচ্ছে তা বলুন।", "hi": "उल्टी या दस्त कितनी बार हो रहे हैं, यह बताएं।"},
          "depends_on": ["hpi.associated"],
          "when": [{"question_id": "hpi.associated", "operator": "contains", "value": "gastrointestinal"}]
        },
        {
          "question_id": "hpi.abdominal_details",
          "field": "hpi.abdominal_details",
          "type": "short_text",
          "required": true,
          "allow_unknown": true,
          "text": {"en": "Where is the abdominal discomfort, and what does it feel like?", "bn": "পেটের কোথায় অস্বস্তি এবং কেমন অনুভূতি হচ্ছে?", "hi": "पेट में तकलीफ कहां है और कैसी महसूस होती है?"},
          "depends_on": ["hpi.associated"],
          "when": [{"question_id": "hpi.associated", "operator": "contains", "value": "abdominal_discomfort"}]
        },
        {
          "question_id": "hpi.urinary_details",
          "field": "hpi.urinary_details",
          "type": "short_text",
          "required": true,
          "allow_unknown": true,
          "text": {"en": "Please describe the urinary difficulty, including burning, frequency, or pain.", "bn": "প্রস্রাবের জ্বালা, ঘন ঘন হওয়া বা ব্যথা সম্পর্কে বলুন।", "hi": "पेशाब में जलन, बार-बार पेशाब या दर्द के बारे में बताएं।"},
          "depends_on": ["hpi.associated"],
          "when": [{"question_id": "hpi.associated", "operator": "contains", "value": "urinary"}]
        },
        {
          "question_id": "hpi.rash_details",
          "field": "hpi.rash_details",
          "type": "short_text",
          "required": true,
          "allow_unknown": true,
          "text": {"en": "Where is the rash, and when did it appear?", "bn": "ফুসকুড়ি কোথায় এবং কখন দেখা দিয়েছে?", "hi": "चकत्ते कहां हैं और कब दिखाई दिए?"},
          "depends_on": ["hpi.associated"],
          "when": [{"question_id": "hpi.associated", "operator": "contains", "value": "rash"}]
        }
      ]
    },
    {
      "section_id": "past_medical_history",
      "label": {"en": "Health history", "bn": "স্বাস্থ্য ইতিহাস", "hi": "स्वास्थ्य इतिहास"},
      "questions": [
        {
          "question_id": "past_medical_history.conditions",
          "field": "past_medical_history.conditions",
          "type": "multiple_choice",
          "required": true,
          "allow_unknown": true,
          "text": {"en": "Have you been told by a clinician that you have any of these ongoing health conditions?", "bn": "চিকিৎসক কি বলেছেন যে আপনার এই দীর্ঘমেয়াদি সমস্যাগুলির কোনোটি আছে?", "hi": "क्या किसी चिकित्सक ने बताया है कि आपको इनमें से कोई पुरानी स्वास्थ्य समस्या है?"},
          "options": [
            {"value": "diabetes", "label": {"en": "Diabetes", "bn": "ডায়াবেটিস", "hi": "मधुमेह"}, "exclusive": false},
            {"value": "hypertension", "label": {"en": "High blood pressure", "bn": "উচ্চ রক্তচাপ", "hi": "उच्च रक्तचाप"}, "exclusive": false},
            {"value": "asthma", "label": {"en": "Asthma or another breathing condition", "bn": "হাঁপানি বা শ্বাসের সমস্যা", "hi": "अस्थमा या सांस की बीमारी"}, "exclusive": false},
            {"value": "other", "label": {"en": "Another ongoing condition", "bn": "অন্য দীর্ঘমেয়াদি সমস্যা", "hi": "कोई अन्य पुरानी समस्या"}, "exclusive": false},
            {"value": "none", "label": {"en": "None of these", "bn": "এগুলির কোনোটিই নয়", "hi": "इनमें से कोई नहीं"}, "exclusive": true}
          ]
        },
        {
          "question_id": "past_medical_history.details",
          "field": "past_medical_history.details",
          "type": "short_text",
          "required": true,
          "allow_unknown": true,
          "text": {"en": "Please describe the other ongoing condition.", "bn": "অন্য দীর্ঘমেয়াদি সমস্যাটি বলুন।", "hi": "अन्य पुरानी स्वास्थ्य समस्या के बारे में बताएं।"},
          "depends_on": ["past_medical_history.conditions"],
          "when": [{"question_id": "past_medical_history.conditions", "operator": "contains", "value": "other"}]
        }
      ]
    },
    {
      "section_id": "medications",
      "label": {"en": "Current medications", "bn": "বর্তমান ওষুধ", "hi": "वर्तमान दवाएं"},
      "questions": [
        {
          "question_id": "medications.any",
          "field": "medications.any",
          "type": "boolean",
          "required": true,
          "allow_unknown": true,
          "text": {"en": "Are you taking any medicines or supplements?", "bn": "আপনি কি কোনো ওষুধ বা সাপ্লিমেন্ট নিচ্ছেন?", "hi": "क्या आप कोई दवा या सप्लीमेंट ले रहे हैं?"}
        },
        {
          "question_id": "medications.details",
          "field": "medications.details",
          "type": "short_text",
          "required": true,
          "allow_unknown": true,
          "text": {"en": "List names, doses and how often you take them, if known.", "bn": "জানা থাকলে ওষুধের নাম, মাত্রা ও কতবার নেন বলুন।", "hi": "यदि पता हो तो दवाओं के नाम, खुराक और कितनी बार लेते हैं, बताएं।"},
          "depends_on": ["medications.any"],
          "when": [{"question_id": "medications.any", "operator": "equals", "value": true}]
        }
      ]
    },
    {
      "section_id": "allergies",
      "label": {"en": "Allergies", "bn": "অ্যালার্জি", "hi": "एलर्जी"},
      "questions": [
        {
          "question_id": "allergies.any",
          "field": "allergies.any",
          "type": "boolean",
          "required": true,
          "allow_unknown": true,
          "text": {"en": "Do you know of any allergies?", "bn": "আপনার কোনো অ্যালার্জি আছে বলে জানেন কি?", "hi": "क्या आपको किसी एलर्जी के बारे में पता है?"}
        },
        {
          "question_id": "allergies.details",
          "field": "allergies.details",
          "type": "short_text",
          "required": true,
          "allow_unknown": true,
          "text": {"en": "What are you allergic to, and what reaction occurs?", "bn": "কীসে অ্যালার্জি এবং কী প্রতিক্রিয়া হয়?", "hi": "किस चीज से एलर्जी है और क्या प्रतिक्रिया होती है?"},
          "depends_on": ["allergies.any"],
          "when": [{"question_id": "allergies.any", "operator": "equals", "value": true}]
        }
      ]
    },
    {
      "section_id": "review_of_systems",
      "label": {"en": "Additional information", "bn": "অতিরিক্ত তথ্য", "hi": "अतिरिक्त जानकारी"},
      "questions": [
        {
          "question_id": "review_of_systems.details",
          "field": "review_of_systems.details",
          "type": "short_text",
          "required": false,
          "allow_unknown": true,
          "text": {"en": "Is there anything else you want the doctor to know?", "bn": "চিকিৎসককে আর কিছু জানাতে চান?", "hi": "क्या आप डॉक्टर को कुछ और बताना चाहते हैं?"}
        }
      ]
    }
  ]
}
