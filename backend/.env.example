# Backend-only Supabase Session pooler URL from the project's Connect dialog.
# Percent-encode reserved characters in the password and keep sslmode=require.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PERCENT_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
APP_ENV=development
DEMO_MODE=true
CLINICAL_NORMALIZATION_PROVIDER=mock
# Optional: default 0.5 seconds for mock, 8 for nvidia; allowed 0.01-15 seconds.
# CLINICAL_NORMALIZATION_TIMEOUT_SECONDS=8
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
CLINICAL_NORMALIZATION_MODEL=google/gemma-4-31b-it
CLINICAL_NORMALIZATION_MAX_TOKENS=768
SPEECH_PROVIDER=mock
# Sarvam AI providers (recommended live providers for this prototype):
SARVAM_API_KEY=
# SARVAM_TIMEOUT_SECONDS=12
# SARVAM_ASR_MODEL=saaras:v3
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh
# SARVAM_TRANSLATION_MODEL=mayura:v1
TRANSLATION_PROVIDER=mock
OCR_PROVIDER=mock
ABDM_ENV=mock
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
HIS_ENDPOINT_URL=
# RAG Semantic Embeddings
RAG_EMBEDDING_PROVIDER=mock
RAG_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# RAG_EMBEDDING_TIMEOUT_SECONDS=10.0
# Calibrated for nvidia/nemotron-3-embed-1b (clinical relevant ~0.30-0.49, negative controls ~0.09-0.16)
RAG_MIN_SIMILARITY=0.25
# Optional patient-friendly wording for an already selected deterministic RAG candidate.
RAG_GENERATION_PROVIDER=template
RAG_GENERATION_MODEL=meta/llama-3.2-11b-vision-instruct
# Fast OpenAI-compatible wording alternative:
# RAG_GENERATION_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# RAG_GENERATION_MODEL=openai/gpt-oss-20b
RAG_TOP_K=3
# RAG_GENERATION_TIMEOUT_SECONDS=20.0
CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
