# Portable local PostgreSQL is provisioned by scripts/setup-postgres.ps1.
# For an existing PostgreSQL server, provide your own URL instead.
DATABASE_URL=postgresql+psycopg://medikiosk:REPLACE_ME@127.0.0.1:55432/medikiosk
APP_ENV=development
DEMO_MODE=true
CLINICAL_NORMALIZATION_PROVIDER=mock
# Optional: default 0.5 seconds for mock, 8 for nvidia; allowed 0.01-15 seconds.
# CLINICAL_NORMALIZATION_TIMEOUT_SECONDS=8
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
CLINICAL_NORMALIZATION_MODEL=google/gemma-4-31b-it
CLINICAL_NORMALIZATION_MAX_TOKENS=768
SPEECH_PROVIDER=mock
# Live BHASHINI remains optional. Standard discovery mode requires both values.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
# Optional provider overrides:
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543d6
# BHASHINI_ENDPOINT_URL=https://meity-auth.ulca.ai
# BHASHINI_TIMEOUT_SECONDS=15
# Alternative direct-inference mode requires both values:
# BHASHINI_INFERENCE_URL=
# BHASHINI_INFERENCE_API_KEY=
OCR_PROVIDER=mock
ABDM_ENV=mock
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
HIS_ENDPOINT_URL=
CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
